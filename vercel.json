{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.rutina.al" }],
      "destination": "https://rutina.al/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/expire-meal-photos",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/charge-ended-trials",
      "schedule": "0 4 * * *"
    }
  ]
}
